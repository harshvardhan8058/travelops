    "/api/v1/incidents/{incident_id}/run": {
      "post": {
        "description": "Drive the incident forward.\n\nStopping short of a terminal state is a normal outcome: `awaiting_approval` means the\ngate asked for a person, and `note` says so. An illegal transition raises\n`409 INVALID_STATE_TRANSITION` from the state machine rather than being silently ignored.\n\nReplay protection uses `decision_log` as the ledger. A `WORKFLOW_RUN_REQUESTED` entry\nrecords the key alongside the result it produced, so a repeated key returns that result\nwithout advancing again. The alternative \u2014 a dedicated idempotency table \u2014 would need a\nmigration, and `backend/migrations/` is Stream C's.",
        "operationId": "run_incident_api_v1_incidents__incident_id__run_post",
        "parameters": [
          {
            "in": "path",
            "name": "incident_id",
            "required": true,
            "schema": {
              "title": "Incident Id",
              "type": "string"
            }
          },
          {
            "description": "Replaying a key returns the original result instead of acting twice.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Replaying a key returns the original result instead of acting twice.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Continue the workflow from its current legal state",
        "tags": [
          "incidents"
        ]
      }
    },
