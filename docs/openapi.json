    "/api/v1/assurance/{assurance_id}/decision": {
      "post": {
        "description": "Record an immutable operator response for one evaluation.\n\nIdempotency here comes from the schema rather than a cache: `human_decision.assurance_id`\nis unique, so one evaluation can only ever carry one decision. Re-posting the same\ndecision returns the original; posting a different one is a conflict, because an\noperator response is a record of what someone decided and not a mutable setting.",
        "operationId": "record_decision_api_v1_assurance__assurance_id__decision_post",
        "parameters": [
          {
            "in": "path",
            "name": "assurance_id",
            "required": true,
            "schema": {
              "title": "Assurance Id",
              "type": "integer"
            }
          },
          {
            "description": "A replay returns the original decision.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A replay returns the original decision.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Operator approve or reject, with a reason",
        "tags": [
          "assurance"
        ]
      }
    },
