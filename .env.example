# TravelOps AI — copy to .env and adjust. NEVER commit .env.
#
# Secrets belong here only. If a value is blank below, the corresponding mode must
# be a fixture/offline mode, or startup fails closed.

APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- datastores
# Host-facing values. Inside Docker Compose the hosts are `postgres` and `redis`.
DATABASE_URL=postgresql+asyncpg://travelops:travelops@localhost:5432/travelops
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- reasoning
# NEVER put a real key in this file. `.gitignore` ignores `.env` and `.env.*` but deliberately
# un-ignores `.env.example`, so anything written here is committed. Copy this to `.env`
# (`make env`) and put credentials there.
#
# LLM_MODE:     live | fixture | off. fixture replays recorded responses; off uses the
#               deterministic fallback playbook only. `live` with no key refuses to start.
# LLM_PROVIDER: which OpenAI-compatible endpoint `live` calls: openrouter | groq.
#               Both serve openai/gpt-oss-120b behind the same chat-completions contract.
#               openrouter is the default because Groq's free/developer tier caps an account at
#               8000 tokens per minute, counted as prompt_tokens + max_tokens, which refused the
#               explainer and reporter outright with HTTP 413 rate_limit_exceeded.
LLM_MODE=fixture
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Only read when LLM_PROVIDER=groq. Groq decommissioned llama-3.3-70b-versatile on 2026-08-16;
# see https://console.groq.com/docs/deprecations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1

# ---------------------------------------------------------------- weather
# live calls the Aviation Weather Center. fixture reads the committed snapshot.
#
# AWC is a public-domain US-government API and needs no credential, so WEATHER_MODE=live works
# with nothing else set. A live call that fails degrades at runtime through the provider's own
# typed error, never by silently swapping in the snapshot.
#
# In live mode the current observation for the airport in scope is added to the
# weather_observation ledger (provenance_kind=real, provider=awc) before delay risk is scored.
# Which observation is SCORED is unchanged: the newest actual reading at or before the incident's
# own clock. So an incident opened now scores live weather, while replaying a historical scenario
# still scores the observation that was current then — and says so in the decision log rather than
# leaving a live-badged run looking as though live data drove it.
WEATHER_MODE=fixture
WEATHER_POLL_SECONDS=60

# ---------------------------------------------------------------- flight status
# live calls AviationStack. fixture replays fixtures/flight_status/aviationstack_snapshot.json.
#
# Unlike weather, live REQUIRES a key: FLIGHT_STATUS_MODE=live with an empty
# AVIATIONSTACK_API_KEY refuses to start. That is deliberate — a flight-status source quietly
# replaced by a snapshot would put replayed departure times behind a live badge and feed them to
# the connection walk as though they had been observed.
#
# Set ALLOW_FLIGHT_STATUS_DEGRADATION=true only if you would rather fall back to the snapshot
# than fail to start. The fallback is then recorded in GET /system/mode's `degradations`, so it
# stays visible; it is never silent either way.
#
# NEVER put a real key in this file — it is committed. Put it in .env.
FLIGHT_STATUS_MODE=fixture
AVIATIONSTACK_API_KEY=
ALLOW_FLIGHT_STATUS_DEGRADATION=false

# Deterministic risk index (0-100), NOT a calibrated probability.
DELAY_RISK_EVENT_THRESHOLD=75

# ---------------------------------------------------------------- notifications
# console logs only. mailtrap/gmail require SMTP_* and a non-empty allowlist.
NOTIFICATION_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Comma-separated. Real email is sent ONLY to these addresses; everything else is
# recorded as a simulated delivery.
DEMO_RECIPIENT_ALLOWLIST=

# ---------------------------------------------------------------- policy
# demo    = fictional fixture, no legal claim
# charter = MoCA Passenger Charter Feb 2019 pack, real cited figures, dated badge
# verified= requires an approved primary-source pack; currently unreachable
POLICY_MODE=charter
POLICY_PACK_DIR=./policy_packs
POLICY_PACK_ID=in-moca-charter-2019
POLICY_PACK_VERSION=2019.02

# ---------------------------------------------------------------- assurance
# Missing or unreadable config must refuse workflow execution.
ASSURANCE_CONFIG_PATH=./config/assurance.v1.yaml
# Plan-level (group-scoped) assurance. Separate from the action gate above so a Phase 1
# evaluation keeps reporting the semantics it was actually decided under.
PLAN_CONFIG_PATH=./config/assurance.v2.yaml

# Browser origins the API accepts. The console is a different origin from the API, so a missing
# entry renders every screen empty with the reason only in the browser console.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# ---------------------------------------------------------------- safety limits
MAX_WORKFLOW_STEPS=20
ACTION_TIMEOUT_SECONDS=30

# Wall-clock allowances for the OPTIONAL planner candidate. The deterministic playbook plan is
# persisted and selected before the model is asked, so every one of these can only cost a
# candidate — never the recovery.
#
# PLANNER_CANDIDATE_BUDGET_SECONDS ........ per-member cap for non-primary members.
# PRIMARY_DEMO_PLANNER_CANDIDATE_BUDGET_SECONDS
#     Reserved allowance for the declared primary member of DEMO_DATASET_ID. Keep it ABOVE the
#     client's 60s per-attempt timeout: below that the primary's provider call is cancelled before
#     it can finish or be retried, which is what removed the primary's candidate in live runs.
# PLANNER_GROUP_POOL_SECONDS .............. shared pool the non-primary members draw from, charged
#     by the time they actually use. Independent per-member budgets reserve time a healthy run
#     never spends; pooling leaves room for the primary's reservation at no cost to the total.
PLANNER_CANDIDATE_BUDGET_SECONDS=20
PRIMARY_DEMO_PLANNER_CANDIDATE_BUDGET_SECONDS=75
PLANNER_GROUP_POOL_SECONDS=75

# ---------------------------------------------------------------- demo data
DATA_SEED=20260807
DEMO_DATASET_ID=bengaluru_storm

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# true serves committed fixtures so the UI runs with no backend at all.
VITE_USE_FIXTURES=false
