# TravelOps AI — copy to .env and adjust. NEVER commit .env.
#
# Secrets belong here only. If a value is blank below, the corresponding mode must
# be a fixture/offline mode, or startup fails closed.

APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- datastores
# Host-facing values. Inside Docker Compose the hosts are `postgres` and `redis`.
DATABASE_URL=postgresql+asyncpg://travelops:travelops@localhost:5432/travelops
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- reasoning
# live requires GROQ_API_KEY. fixture replays recorded responses. off uses the
# deterministic fallback playbook only.
LLM_MODE=fixture
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# ---------------------------------------------------------------- weather
# live calls the Aviation Weather Center. fixture reads the committed snapshot.
WEATHER_MODE=fixture
WEATHER_POLL_SECONDS=60

# Deterministic risk index (0-100), NOT a calibrated probability.
DELAY_RISK_EVENT_THRESHOLD=75

# ---------------------------------------------------------------- notifications
# console logs only. mailtrap/gmail require SMTP_* and a non-empty allowlist.
NOTIFICATION_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Comma-separated. Real email is sent ONLY to these addresses; everything else is
# recorded as a simulated delivery.
DEMO_RECIPIENT_ALLOWLIST=

# ---------------------------------------------------------------- policy
# demo    = fictional fixture, no legal claim
# charter = MoCA Passenger Charter Feb 2019 pack, real cited figures, dated badge
# verified= requires an approved primary-source pack; currently unreachable
POLICY_MODE=charter
POLICY_PACK_DIR=./policy_packs
POLICY_PACK_ID=in-moca-charter-2019
POLICY_PACK_VERSION=2019.02

# ---------------------------------------------------------------- assurance
# Missing or unreadable config must refuse workflow execution.
ASSURANCE_CONFIG_PATH=./config/assurance.v1.yaml

# ---------------------------------------------------------------- safety limits
MAX_WORKFLOW_STEPS=20
ACTION_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- demo data
DATA_SEED=20260807
DEMO_DATASET_ID=bengaluru_storm

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# true serves committed fixtures so the UI runs with no backend at all.
VITE_USE_FIXTURES=true
